<svg width="512" height="512" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
    <defs>
        <!-- 3D Gradient Definitions -->
        <radialGradient id="mainGradient" cx="0.3" cy="0.3" r="0.7">
            <stop offset="0%" style="stop-color:#FF8C00;stop-opacity:1" />
            <stop offset="40%" style="stop-color:#CC5500;stop-opacity:1" />
            <stop offset="100%" style="stop-color:#B8460C;stop-opacity:1" />
        </radialGradient>
        <radialGradient id="textGradient" cx="0.5" cy="0.3" r="0.8">
            <stop offset="0%" style="stop-color:#222222;stop-opacity:1" />
            <stop offset="30%" style="stop-color:#111111;stop-opacity:1" />
            <stop offset="70%" style="stop-color:#000000;stop-opacity:1" />
            <stop offset="100%" style="stop-color:#000000;stop-opacity:1" />
        </radialGradient>
        <radialGradient id="shimmer" cx="0.2" cy="0.2" r="0.6">
            <stop offset="0%" style="stop-color:rgba(255,255,255,0.8);stop-opacity:1" />
            <stop offset="50%" style="stop-color:rgba(255,255,255,0.3);stop-opacity:1" />
            <stop offset="100%" style="stop-color:rgba(255,255,255,0);stop-opacity:0" />
        </radialGradient>
        <!-- 3D Emboss Filter -->
        <filter id="emboss" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur in="SourceAlpha" stdDeviation="3"/>
            <feOffset dx="3" dy="3" result="offset1"/>
            <feFlood flood-color="rgba(0,0,0,0.8)"/>
            <feComposite in2="offset1" operator="in"/>
            <feMerge>
                <feMergeNode/>
                <feMergeNode in="SourceGraphic"/>
            </feMerge>
        </filter>
    </defs>
    
    <!-- Outer Ring with 3D Effect -->
    <circle cx="256" cy="256" r="230" fill="url(#mainGradient)" stroke="rgba(0,0,0,0.5)" stroke-width="4"/>
    
    <!-- Thick White Border Ring -->
    <circle cx="256" cy="256" r="210" fill="none" stroke="#FFFFFF" stroke-width="24"/>
    
    <circle cx="256" cy="256" r="170" fill="none" stroke="rgba(255,255,255,0.3)" stroke-width="2"/>
    <circle cx="256" cy="256" r="150" fill="none" stroke="rgba(255,255,255,0.15)" stroke-width="1"/>
    
    <!-- Additional button-like white lines -->
    <circle cx="256" cy="256" r="190" fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="1"/>
    <circle cx="256" cy="256" r="130" fill="none" stroke="rgba(255,255,255,0.25)" stroke-width="1"/>
    <circle cx="256" cy="256" r="110" fill="none" stroke="rgba(255,255,255,0.15)" stroke-width="0.5"/>
    
    <!-- PRO Text with Enhanced Effects -->
    <!-- White shadow layer -->
    <text x="260" y="308" font-family="Arial Black, Arial, sans-serif" font-size="116" font-weight="900" 
          text-anchor="middle" fill="rgba(255,255,255,0.2)" opacity="0.6" letter-spacing="8px">PRO</text>
    <text x="258" y="305" font-family="Arial Black, Arial, sans-serif" font-size="116" font-weight="900" 
          text-anchor="middle" fill="rgba(255,255,255,0.15)" opacity="0.4" letter-spacing="8px">PRO</text>
    
    <!-- Main text with enhanced gradient -->
    <text x="256" y="300" font-family="Arial Black, Arial, sans-serif" font-size="116" font-weight="900" 
          text-anchor="middle" fill="url(#textGradient)" filter="url(#emboss)" stroke="rgba(255,255,255,0.1)" stroke-width="0.5" letter-spacing="8px">PRO</text>
    
    <!-- White highlight layer for depth -->
    <text x="254" y="298" font-family="Arial Black, Arial, sans-serif" font-size="116" font-weight="900" 
          text-anchor="middle" fill="rgba(255,255,255,0.3)" opacity="0.5" letter-spacing="8px">PRO</text>
    
    <!-- Additional Depth Rings -->
    <circle cx="256" cy="256" r="200" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="1"/>
    <circle cx="256" cy="256" r="140" fill="none" stroke="rgba(0,0,0,0.1)" stroke-width="1"/>
    
    <!-- Edge Enhancement -->
    <circle cx="256" cy="256" r="218" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="2"/>
    <circle cx="256" cy="256" r="222" fill="none" stroke="rgba(0,0,0,0.2)" stroke-width="1"/>
</svg>
